<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow -->
    <item android:left="1dp" android:right="1dp" android:top="3dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#35000000"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <!-- Glass gradient fill + border -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#22FFFFFF"
                android:endColor="#0DFFFFFF"/>
            <stroke android:width="1.5dp" android:color="#40FFFFFF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
