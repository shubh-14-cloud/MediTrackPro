<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediTrackPro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/surface_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <item name="android:buttonStyle">@style/GlassButton</item>
    </style>

    <style name="GlassButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/glass_button_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
</resources>
